# Copy this file to .env and paste your keys in. .env is gitignored.
#
# Groq  (free)  -> https://console.groq.com/keys        key starts with gsk_
# Gemini (free) -> https://aistudio.google.com/apikey   key starts with AIza
#
# No quotes needed. No spaces around the = sign.

GROQ_API_KEY=
GEMINI_API_KEY=

# Optional. Providers retire model names on their own schedule, so these are
# overridable here rather than in code. Run scripts/diagnose_keys.py to see
# which models your key can actually reach.
# NANO_MODEL=llama-3.1-8b-instant
# STANDARD_MODEL=llama-3.3-70b-versatile
# PREMIUM_MODEL=gemini-2.0-flash

# Optional, but set it before sharing this with anyone. Who the drafts are
# written as. With nothing here every brief says "the person using this"
# rather than inventing a name, and approvals are recorded against "owner".
# Also settable from the Connect screen, which is the easier way.
# OWNER_NAME=
# OWNER_ABOUT=21, a marketer and builder

# Optional. Repositories the "Pull this week from my git" button reads,
# semicolon-separated. Commit messages only, never file contents. Leave unset
# and it reads this repository plus any other git checkout sitting beside it.
# REPOS=E:\imp\projects\agentic os;E:\imp\projects\ventureadda

# Optional. How often each agent runs itself while the studio is open, in
# minutes. The defaults are five minutes for mail, six hours for deadlines
# and three hours for classwork. Longer costs you nothing but freshness;
# shorter than a minute is refused, because polling a mailbox that fast is
# how an account gets rate limited.
# INBOX_EVERY_MINUTES=5
# APPLY_EVERY_MINUTES=360
# CLASSWORK_EVERY_MINUTES=180

# Hosting only, see docs/HOSTING.md. On your own machine leave these unset.
# STUDIO_PASSWORD switches on the login and binds every interface; REPO_URLS
# lists repositories to clone for "pull from git", since a container has no
# checkouts beside it. Public ones only; a token in a URL is more surface
# than this needs.
# STUDIO_PASSWORD=
# REPO_URLS=https://github.com/JASMEHRR/ventureadda

# Optional, posting only. See docs/LINKEDIN_POSTING.md. Free: these come from
# a LinkedIn developer app you own, and the token stays on this machine.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:8770/callback
#
# Points the vendored linkedin-skills bundle at the poster above rather than
# at Publora. Use the full path.
# LINKEDIN_SKILLS_CUSTOM_POSTER=python /path/to/agent-os/scripts/linkedin_post.py poster
#
# Backup route, used only when LinkedIn itself cannot run. Deliberately not
# named LINKEDIN_PLATFORM_ID: that name makes the bundle skip the poster.
# PUBLORA_API_KEY=
# PUBLORA_PLATFORM_ID=

# Optional, the Numbers tab only. LinkedIn's own API does not return post
# performance to an app like this one, so engagement counts are read through
# Apify's public actors instead: https://console.apify.com/account/integrations
# Without it the tab shows what was already collected and refuses to fetch
# more. Reading public counts this way is against LinkedIn's terms; it is a
# choice worth making on purpose rather than by leaving a variable set.
# APIFY_TOKEN=
